# =============================================================================
# Flvxus v2 — variáveis de ambiente (exemplo)
# Copie para .env.local e preencha com valores reais. NUNCA commite segredos.
# =============================================================================

# Supabase — projeto hospedado (URL e chave pública/anon ficam no cliente)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Supabase — service role (SOMENTE no servidor; nunca exponha no cliente)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Anthropic — usada SOMENTE nas Edge Functions (nunca no cliente)
ANTHROPIC_API_KEY=sua-chave-anthropic-aqui
ANTHROPIC_MODEL=claude-sonnet-4-5

# URL pública do site (usada em redirects de auth e configuração de API)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo compartilhado para proteger rotas de cron/agendadas
CRON_SECRET=defina-um-segredo-aleatorio-aqui
