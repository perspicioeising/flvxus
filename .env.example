# =============================================================================
# Flvxus v2 — variáveis de ambiente (exemplo)
# Copie para .env.local e preencha com valores reais. NUNCA commite segredos.
# Apenas este arquivo (.env.example, com placeholders) vai para o git.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — projeto hospedado
# -----------------------------------------------------------------------------
# URL e chave pública (anon) PODEM ir para o cliente (prefixo NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# service_role IGNORA o RLS — SOMENTE no servidor/Edge Functions. Nunca no cliente.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# -----------------------------------------------------------------------------
# Anthropic (IA) — usada SOMENTE nas Supabase Edge Functions, nunca no cliente
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sua-chave-anthropic-aqui
# Modelo configurável (ADR 0001). Família vigente: claude-sonnet-5-5 (padrão do
# produto), claude-opus-5-5 (análises complexas), claude-haiku-5-5 (tarefas baratas).
# Confirme o ID exato de snapshot via Models API (GET /v1/models) no deploy.
ANTHROPIC_MODEL=claude-sonnet-5-5

# -----------------------------------------------------------------------------
# URLs públicas
# -----------------------------------------------------------------------------
# Usada em redirects de auth (magic link / reset de senha) e configuração de API.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL absoluta da API para o app nativo (Capacitor). Em web = NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Jobs agendados (cron) — protege as rotas de cron contra chamadas externas
# -----------------------------------------------------------------------------
CRON_SECRET=defina-um-segredo-aleatorio-aqui

# -----------------------------------------------------------------------------
# WhatsApp (opcional) — só se a integração de mensagens for habilitada.
# Deixe em branco para manter a integração desligada. Tokens são segredos de
# servidor; nunca exponha no cliente. (Ver docs/pendencias.md — integração a
# revisar nas próximas fases.)
# -----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
