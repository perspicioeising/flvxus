# -----------------------------------------------------------------------------
# Anthropic (IA) — usada SOMENTE nas Supabase Edge Functions, nunca no cliente
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sua-chave-anthropic-aqui
# Modelo configurável (ADR 0001). Use o ID EXATO da API (GET /v1/models).
# IDs válidos na conta (out/2026): claude-sonnet-5-5 (padrão do produto),
# claude-opus-5-5, claude-haiku-5-5, claude-fable-5-1, claude-sonnet-5, etc.
# Descubra os liberados para a sua conta com:
#   curl https://api.anthropic.com/v1/models -H "x-api-key: SUA_CHAVE" -H "anthropic-version: 2023-06-01"
ANTHROPIC_MODEL=claude-sonnet-5-5

# -----------------------------------------------------------------------------
# URLs públicas
# -----------------------------------------------------------------------------
# Usada em redirects de auth (magic link / convite / reset de senha) e config de API.
# Em DEV use http://localhost:3000. Em PRODUÇÃO (Vercel) defina o domínio oficial:
#   NEXT_PUBLIC_SITE_URL=https://flvxus.vercel.app
# As Redirect URLs do Supabase (Authentication > URL Configuration) precisam casar
# com ${NEXT_PUBLIC_SITE_URL}/callback. Ver docs/pendencias.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL absoluta da API para o app nativo (Capacitor). Em web = NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Jobs agendados (cron) — protege as rotas de cron contra chamadas externas
# -----------------------------------------------------------------------------
CRON_SECRET=defina-um-segredo-aleatorio-aqui

