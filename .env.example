# -----------------------------------------------------------------------------
# Anthropic (IA) — usada SOMENTE nas Supabase Edge Functions, nunca no cliente
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sua-chave-anthropic-aqui
# Modelo configurável (ADR 0001). Família vigente: claude-sonnet-5-5 (padrão do
# produto), claude-opus-5-5 (análises complexas), claude-haiku-5-5 (tarefas baratas).
# Confirme o ID exato de snapshot via Models API (GET /v1/models) no deploy.
ANTHROPIC_MODEL=claude-sonnet-5-5

# -----------------------------------------------------------------------------
# URLs públicas
# -----------------------------------------------------------------------------
# Usada em redirects de auth (magic link / reset de senha) e configuração de API.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL absoluta da API para o app nativo (Capacitor). Em web = NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_API_URL=http://localhost:3000

