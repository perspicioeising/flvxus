### **3. Progress Steps**
```typescript
{/* Step Container */}
<div className="flex items-center justify-center space-x-4 flex-wrap gap-y-4">
  {steps.map((step, index) => {
    const isActive = activeTab === step.id;
    const isCompleted = completedSteps.includes(step.id);
    
    return (
      <div key={step.id} className="flex items-center">
        {/* Step Circle */}
        <div className={`relative flex items-center justify-center w-14 h-14 
                         rounded-2xl transition-all duration-300 shadow-lg ${
          isActive
            ? `bg-gradient-to-r ${step.color} text-white transform scale-110`
            : isCompleted
              ? 'bg-gradient-to-r from-green-500 to-emerald-500 text-white'
              : 'bg-white dark:bg-gray-800 text-gray-500 border-2 border-gray-200'
        }`}>
          
          {/* Step Icon */}
          {isCompleted ? (
            <CheckCircle2 className="h-7 w-7" />
          ) : (
            <StepIcon className="h-7 w-7" />
          )}
          
          {/* Active Badge */}
          {isActive && (
            <div className="absolute -top-1 -right-1 w-5 h-5 
                             bg-gradient-to-r from-yellow-400 to-orange-500 
                             rounded-full flex items-center justify-center">
              <Star className="h-2.5 w-2.5 text-white" />
            </div>
          )}
        </div>
        
        {/* Connector Line */}
        {index < steps.length - 1 && (
          <div className={`mx-6 h-1 w-12 rounded-full transition-all duration-300 ${
            isCompleted 
              ? 'bg-gradient-to-r from-green-500 to-emerald-500' 
              : 'bg-gray-200 dark:bg-gray-700'
          }`} />
        )}
      </div>
    );
  })}
</div>
```

