{
  "name": "flvxus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cap:init": "cap init",
    "cap:sync": "next build && cap sync",
    "cap:copy": "next build && cap copy",
    "cap:update": "next build && cap update",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:run:android": "npm run cap:sync && cap run android",
    "cap:run:ios": "npm run cap:sync && cap run ios",
    "build:android": "next build && cap sync android && cd android && ./gradlew assembleRelease",
    "build:ios": "next build && cap sync ios",
    "test:rls": "vitest run tests/rls",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > types/database.types.ts"
  },
